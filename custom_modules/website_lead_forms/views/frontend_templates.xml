<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="contact_form_page" name="Contact Form">
        <t t-call="website.layout">
            <div id="wrap" class="o_wforum_wrapper">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-7 col-md-9">
                            <h2 class="mb-1" t-esc="form.name"/>
                            <p class="text-muted mb-4">Fill in the form below and we will get back to you shortly.</p>

                            <t t-if="error">
                                <div class="alert alert-danger" role="alert">
                                    <t t-esc="error"/>
                                </div>
                            </t>

                            <form t-attf-action="/contact/#{form.slug}/submit" method="post" novalidate="novalidate">

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="contact_name">
                                            Name <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control" id="contact_name"
                                            name="contact_name" required="required"
                                            t-att-value="post.get('contact_name', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="email_from">
                                            Email <span class="text-danger">*</span>
                                        </label>
                                        <input type="email" class="form-control" id="email_from"
                                            name="email_from" required="required"
                                            t-att-value="post.get('email_from', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="phone">Phone</label>
                                        <input type="tel" class="form-control" id="phone"
                                            name="phone"
                                            t-att-value="post.get('phone', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="subject">Subject</label>
                                        <input type="text" class="form-control" id="subject"
                                            name="subject"
                                            t-att-value="post.get('subject', '')"/>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold" for="message">Message</label>
                                        <textarea class="form-control" id="message" name="message"
                                            rows="5"><t t-esc="post.get('message', '')"/></textarea>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary px-4">
                                            Send Message
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="contact_form_page_ees" name="Contact Form - EES">
        <t t-call="website.layout">
            <div id="wrap" class="o_wforum_wrapper">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8 col-md-10">
                            <h2 class="mb-1" t-esc="form.name"/>
                            <p class="text-muted mb-4">Fill in the form below and we will get back to you shortly.</p>

                            <t t-if="error">
                                <div class="alert alert-danger" role="alert">
                                    <t t-esc="error"/>
                                </div>
                            </t>

                            <form t-attf-action="/contact/#{form.slug}/submit" method="post" novalidate="novalidate">
                                <div class="row g-3">

                                    <!-- Contact -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="contact_name">
                                            Name <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control" id="contact_name"
                                            name="contact_name" required="required"
                                            t-att-value="post.get('contact_name', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="email_from">
                                            Email <span class="text-danger">*</span>
                                        </label>
                                        <input type="email" class="form-control" id="email_from"
                                            name="email_from" required="required"
                                            t-att-value="post.get('email_from', '')"/>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold" for="subject">
                                            Title of your request <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control" id="subject"
                                            name="subject" required="required"
                                            t-att-value="post.get('subject', '')"/>
                                    </div>

                                    <!-- Academic / Administrative -->
                                    <div class="col-12 mt-2">
                                        <hr class="mb-1"/>
                                        <p class="text-muted small mb-0">Academic / Administrative Details</p>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="supervisor_name">
                                            Supervisor's Name or Research Group <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control" id="supervisor_name"
                                            name="supervisor_name" required="required"
                                            t-att-value="post.get('supervisor_name', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="supervisor_email">
                                            Supervisor's Email <span class="text-danger">*</span>
                                        </label>
                                        <input type="email" class="form-control" id="supervisor_email"
                                            name="supervisor_email" required="required"
                                            t-att-value="post.get('supervisor_email', '')"/>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold" for="worktag">Worktag (if not known, please provide a speedchart in the appropriate field)</label>
                                        <input type="text" class="form-control" id="worktag"
                                            name="worktag"
                                            t-att-value="post.get('worktag', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="speedchart">Speedchart</label>
                                        <input type="text" class="form-control" id="speedchart"
                                            name="speedchart"
                                            t-att-value="post.get('speedchart', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="department">Department</label>
                                        <input type="text" class="form-control" id="department"
                                            name="department"
                                            t-att-value="post.get('department', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="priority">Priority</label>
                                        <select class="form-select" id="priority" name="priority">
                                            <option value="">-- Select --</option>
                                            <option value="Low"
                                                t-att-selected="post.get('priority') == 'Low'">Low</option>
                                            <option value="Normal"
                                                t-att-selected="post.get('priority') == 'Normal'">Normal</option>
                                            <option value="High"
                                                t-att-selected="post.get('priority') == 'High'">High</option>
                                            <option value="Urgent"
                                                t-att-selected="post.get('priority') == 'Urgent'">Urgent</option>
                                        </select>
                                    </div>

                                    <!-- Repair info -->
                                    <div class="col-12">
                                        <label class="form-label fw-semibold" for="repair_info">
                                            If this request is for a repair (answer as best as you know): Make, model, serial number
                                        </label>
                                        <textarea class="form-control" id="repair_info" name="repair_info"
                                            rows="3"><t t-esc="post.get('repair_info', '')"/></textarea>
                                    </div>

                                    <!-- Message -->
                                    <div class="col-12">
                                        <label class="form-label fw-semibold" for="message">Message</label>
                                        <textarea class="form-control" id="message" name="message"
                                            rows="5"><t t-esc="post.get('message', '')"/></textarea>
                                    </div>

                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary px-4">
                                            Send Message
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="contact_form_success" name="Contact Form - Thank You">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container py-5 text-center">
                    <div class="row justify-content-center">
                        <div class="col-lg-6">
                            <i class="fa fa-check-circle fa-4x text-success mb-4"/>
                            <h2>Message Sent!</h2>
                            <p class="lead text-muted">
                                Thank you for reaching out. We will be in touch with you shortly.
                            </p>
                            <a href="/" class="btn btn-primary mt-3">Back to Home</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
