<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_lead_form_list" model="ir.ui.view">
        <field name="name">website.lead.form.list</field>
        <field name="model">website.lead.form</field>
        <field name="arch" type="xml">
            <list string="Website Lead Forms">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_website_lead_form_form" model="ir.ui.view">
        <field name="name">website.lead.form.form</field>
        <field name="model">website.lead.form</field>
        <field name="arch" type="xml">
            <form string="Website Lead Form">
                <sheet>
                    <group>
                        <group string="Form Identity">
                            <field name="name"/>
                            <field name="slug"/>
                            <field name="template"/>
                            <field name="active"/>
                        </group>
                        <group string="Lead Routing">
                            <field name="company_id"/>
                            <field name="user_id"/>
                            <field name="team_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="url" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_website_lead_form" model="ir.actions.act_window">
        <field name="name">Contact Forms</field>
        <field name="res_model">website.lead.form</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_website_lead_forms"
        name="Contact Forms"
        parent="website.menu_website_global_configuration"
        action="action_website_lead_form"
        sequence="100"/>
</odoo>
