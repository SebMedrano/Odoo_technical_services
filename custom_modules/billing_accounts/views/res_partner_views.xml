<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_worktags" model="ir.ui.view">
        <field name="name">res.partner.form.worktags</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Worktags" name="worktags">
                    <field name="worktag_ids">
                        <list>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="project_grant_manager_id" string="Project/Grant Manager (PI)" optional="show"/>
                            <field name="cost_centre"/>
                            <field name="speedchart"/>
                            <field name="client_category"/>
                            <field name="status" decoration-danger="status == 'inactive'" decoration-success="status == 'active'"/>
                            <field name="validated" widget="boolean" decoration-success="validated == True" decoration-warning="validated == False"/>
                            <field name="date_created"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_list_date_created" model="ir.ui.view">
        <field name="name">res.partner.list.date.created</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="is_company" invisible="1"/>
                <field name="date_created" invisible="is_company"/>
            </xpath>
        </field>
    </record>
</odoo>
