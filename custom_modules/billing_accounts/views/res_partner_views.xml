<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_worktags" model="ir.ui.view">
        <field name="name">res.partner.form.worktags</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Worktags" name="worktags">
                    <field name="worktag_ids">
                        <list editable="bottom">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="cost_centre"/>
                            <field name="speedchart"/>
                            <field name="client_category"/>
                            <field name="status"
                                   decoration-danger="status == 'inactive'"
                                   decoration-success="status == 'active'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
