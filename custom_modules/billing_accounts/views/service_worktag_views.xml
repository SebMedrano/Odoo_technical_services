<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_service_worktag_list" model="ir.ui.view">
        <field name="name">service.worktag.list</field>
        <field name="model">service.worktag</field>
        <field name="arch" type="xml">
            <list string="Worktags">
                <field name="code"/>
                <field name="name"/>
                <field name="cost_centre"/>
                <field name="speedchart"/>
                <field name="partner_id"/>
                <!-- decoration-danger highlights inactive rows in red -->
                <field name="status"
                       decoration-danger="status == 'inactive'"
                       decoration-success="status == 'active'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_service_worktag_form" model="ir.ui.view">
        <field name="name">service.worktag.form</field>
        <field name="model">service.worktag</field>
        <field name="arch" type="xml">
            <form string="Worktag">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="speedchart"/>
                            <field name="cost_centre"/>
                        </group>
                        <group string="Details">
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_service_worktag_search" model="ir.ui.view">
        <field name="name">service.worktag.search</field>
        <field name="model">service.worktag</field>
        <field name="arch" type="xml">
            <search string="Search Worktags">
                <field name="code"/>
                <field name="name"/>
                <field name="speedchart"/>
                <field name="cost_centre"/>
                <field name="partner_id"/>
                <filter string="Active" name="active"
                        domain="[('status', '=', 'active')]"/>
                <filter string="Inactive" name="inactive"
                        domain="[('status', '=', 'inactive')]"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_service_worktag" model="ir.actions.act_window">
        <field name="name">Worktags</field>
        <field name="res_model">service.worktag</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_service_worktag_search"/>
    </record>

    <!-- MENU under Invoicing > Configuration -->
    <menuitem
        id="menu_service_worktag"
        name="Worktags"
        parent="account.menu_finance_configuration"
        action="action_service_worktag"
        sequence="100"/>

</odoo>
