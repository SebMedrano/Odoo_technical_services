<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        This view INHERITS the existing analytic account form view
        and injects our new field into it.

        We are not replacing the whole form — just adding one field
        after the existing 'name' field at the top of the form.
    -->
    <record id="view_account_analytic_account_form_billing" model="ir.ui.view">
        <field name="name">account.analytic.account.form.billing</field>

        <!-- The model this view belongs to -->
        <field name="model">account.analytic.account</field>

        <!-- Points to the existing form view we want to extend -->
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>

        <!-- priority 16 means this runs after the base view (priority 16 is default for inherited views) -->
        <field name="priority">16</field>

        <field name="arch" type="xml">
            <!--
                xpath locates WHERE in the existing form to inject our field.
                expr="/form/sheet/group/field[@name='name']" means:
                    find the 'name' field inside the form
                position="after" means:
                    add our content immediately after that field
            -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="external_account_code"
                       placeholder="e.g. ACC-001"/>
            </xpath>
        </field>
    </record>

</odoo>
