<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_form_worktag" model="ir.ui.view">
        <field name="name">account.move.form.worktag</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <!--
                    worktag_commercial_partner_id is invisible — it just
                    makes the company-level partner accessible to the domain.
                    Without it the domain cannot reference a related field.
                -->
                <field name="worktag_commercial_partner_id" invisible="1"/>
                <field name="worktag_id"
                       domain="[('partner_id', '=', worktag_commercial_partner_id)]"/>
                <field name="worktag_confirmed"/>
            </xpath>
        </field>
    </record>

</odoo>
