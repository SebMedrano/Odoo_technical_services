<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        We inherit the existing invoice form view and inject
        two fields into it:
        - worktag_id: shown near the top next to the customer
        - worktag_confirmed: shown as a checkbox the manager can tick

        Both fields are added after the partner_id (Customer) field
        which is the most visible and logical location on the invoice.
    -->
    <record id="view_account_move_form_worktag" model="ir.ui.view">
        <field name="name">account.move.form.worktag</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="worktag_id"/>
                <field name="worktag_confirmed"/>
            </xpath>
        </field>
    </record>

</odoo>
