<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_worktag" model="ir.ui.view">
        <field name="name">account.move.form.worktag</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="worktag_commercial_partner_id" invisible="1"/>
                <field name="worktag_id" domain="[('partner_ids', 'in', [worktag_commercial_partner_id])]" options="{'no_quick_create': True}"/>
                <field name="worktag_confirmed"/>
            </xpath>
        </field>
    </record>
</odoo>
