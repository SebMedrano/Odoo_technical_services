<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_form_worktag" model="ir.ui.view">
        <field name="name">sale.order.form.worktag</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">

                <!--
                    worktag_id: searches and displays by primary billing code.
                    No special context needed — code is the default _rec_name.
                -->
                <field name="worktag_id"/>

                <!--
                    speedchart_id: context={'show_speedchart': True} activates
                    the _compute_display_name and _name_search overrides so
                    this dropdown searches and displays speedchart values only.
                -->
                <field name="speedchart_id"
                       context="{'show_speedchart': True}"/>

            </xpath>
        </field>
    </record>

</odoo>
