<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_order_form_instrument" model="ir.ui.view">
        <field name="name">repair.order.form.instrument</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="instrument_id"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="invisible">instrument_id != False</attribute>
                <attribute name="required">instrument_id == False</attribute>
            </xpath>
        </field>
    </record>
    <menuitem id="menu_service_instrument" name="Instruments"
        parent="repair.menu_repair_order"
        action="action_service_instrument" sequence="5"/>
</odoo>
