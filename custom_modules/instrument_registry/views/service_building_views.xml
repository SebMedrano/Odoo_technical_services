<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_service_building_list" model="ir.ui.view">
        <field name="name">service.building.list</field>
        <field name="model">service.building</field>
        <field name="arch" type="xml">
            <list string="Buildings" editable="top">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_service_building" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">service.building</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="menu_service_building"
        name="Buildings"
        parent="repair.repair_menu_config"
        action="action_service_building"
        sequence="20"/>

</odoo>
