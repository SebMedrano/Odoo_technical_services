<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_service_instrument_form" model="ir.ui.view">
        <field name="name">service.instrument.form</field>
        <field name="model">service.instrument</field>
        <field name="arch" type="xml">
            <form string="Instrument">
                <header>
                    <field name="validated" widget="boolean_button"
                           options="{'terminology': {
                               'string_true': 'Validated',
                               'string_false': 'Not Validated',
                               'hover_true': 'Mark as not validated',
                               'hover_false': 'Mark as validated'
                           }}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_repairs"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-wrench">
                            <field name="repair_count"
                                   widget="statinfo"
                                   string="Repairs"/>
                        </button>
                    </div>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Instrument Details">
                            <field name="make"/>
                            <field name="model"/>
                            <field name="serial_number"/>
                            <field name="description"/>
                            <field name="instrument_type_id"/>
                        </group>
                        <group string="Location">
                            <field name="partner_id"/>
                            <field name="building_id"/>
                            <field name="room"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_service_instrument_list" model="ir.ui.view">
        <field name="name">service.instrument.list</field>
        <field name="model">service.instrument</field>
        <field name="arch" type="xml">
            <list string="Instruments">
                <field name="name"/>
                <field name="make"/>
                <field name="model"/>
                <field name="serial_number"/>
                <field name="instrument_type_id"/>
                <field name="partner_id"/>
                <field name="building_id"/>
                <field name="validated" widget="boolean"
                       decoration-success="validated == True"
                       decoration-warning="validated == False"/>
                <field name="repair_count" string="Repairs"/>
            </list>
        </field>
    </record>

    <record id="view_service_instrument_search" model="ir.ui.view">
        <field name="name">service.instrument.search</field>
        <field name="model">service.instrument</field>
        <field name="arch" type="xml">
            <search string="Search Instruments">
                <field name="name"/>
                <field name="make"/>
                <field name="model"/>
                <field name="serial_number"/>
                <field name="partner_id"/>
                <field name="instrument_type_id"/>
                <field name="building_id"/>
                <filter string="Validated" name="validated" domain="[('validated', '=', True)]"/>
                <filter string="Not Validated" name="not_validated" domain="[('validated', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_service_instrument" model="ir.actions.act_window">
        <field name="name">Instruments</field>
        <field name="res_model">service.instrument</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_service_instrument_search"/>
    </record>

</odoo>
