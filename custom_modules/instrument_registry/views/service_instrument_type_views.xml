<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_instrument_type_list" model="ir.ui.view">
        <field name="name">service.instrument.type.list</field>
        <field name="model">service.instrument.type</field>
        <field name="arch" type="xml">
            <list string="Instrument Types" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_service_instrument_type" model="ir.actions.act_window">
        <field name="name">Instrument Types</field>
        <field name="res_model">service.instrument.type</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_service_instrument_type" name="Instrument Types"
        parent="repair.repair_menu_config"
        action="action_service_instrument_type" sequence="20"/>
</odoo>
