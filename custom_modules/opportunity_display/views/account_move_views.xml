<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_form_opportunity" model="ir.ui.view">
        <field name="name">account.move.form.opportunity</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!--
                Show opportunity on the invoice below the customer field.
                readonly=True — the opportunity is managed on the sale order.
                Clicking it still opens the CRM opportunity for reference.
            -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="opportunity_id" readonly="1"/>
            </xpath>

        </field>
    </record>

</odoo>
