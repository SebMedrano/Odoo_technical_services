<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_task_form_parts" model="ir.ui.view">
        <field name="name">project.task.form.parts</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Parts" name="parts">

                    <field name="task_part_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="quantity"/>
                            <field name="price_unit" string="Unit Price"/>
                            <!--
                                move_state shows the stock move status:
                                draft, confirmed, assigned, done, cancel.
                                Helps the user see at a glance whether
                                the part has been moved in inventory.
                            -->
                            <field name="move_state"
                                   string="Stock Status"
                                   readonly="1"
                                   optional="show"
                                   decoration-success="move_state == 'done'"
                                   decoration-warning="move_state in ['draft', 'confirmed', 'assigned']"
                                   decoration-danger="move_state == 'cancel'"/>
                            <field name="sale_line_id"
                                   string="SO Line"
                                   readonly="1"
                                   optional="show"/>
                            <field name="move_id"
                                   string="Stock Move"
                                   readonly="1"
                                   optional="hide"/>
                        </list>
                    </field>

                    <group>
                        <field name="total_parts_cost"
                               readonly="1"
                               string="Total Parts Cost"
                               widget="monetary"/>
                    </group>

                </page>
            </xpath>

        </field>
    </record>

</odoo>
