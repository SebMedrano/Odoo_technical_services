<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view: timesheets tab + field visibility changes -->
    <record id="view_repair_order_form_timesheet" model="ir.ui.view">
        <field name="name">repair.order.form.timesheet</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Timesheets" name="timesheets">
                    <field name="timesheet_line_ids"
                           readonly="state in ['done', 'cancel']">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="employee_id"/>
                            <field name="name" string="Description"/>
                            <field name="unit_amount" string="Hours" widget="float_time"/>
                            <field name="repair_id" column_invisible="True"/>
                            <field name="project_id" column_invisible="True"/>
                            <field name="task_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group>
                        <field name="total_hours" widget="float_time" readonly="1" string="Total Hours"/>
                    </group>
                </page>
            </xpath>

            <xpath expr="//field[@name='under_warranty']" position="attributes">
                <attribute name="groups">techservices_groups.group_supervisor</attribute>
            </xpath>

            <xpath expr="//page[@name='page_miscellaneous']" position="attributes">
                <attribute name="groups">techservices_groups.group_supervisor</attribute>
            </xpath>

            <xpath expr="//field[@name='sale_order_id']" position="attributes">
                <attribute name="groups">techservices_groups.group_supervisor</attribute>
            </xpath>

            <xpath expr="//field[@name='sale_order_id']" position="after">
                <field name="sale_order_name"
                       string="Sale Order"
                       readonly="1"
                       groups="techservices_groups.group_technician"/>
            </xpath>

        </field>
    </record>

    <!-- List view: hide is_returned from technicians -->
    <record id="view_repair_order_list_hide_returned" model="ir.ui.view">
        <field name="name">repair.order.list.hide.returned</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_returned']" position="attributes">
                <attribute name="groups">techservices_groups.group_supervisor</attribute>
            </xpath>
        </field>
    </record>

    <!-- Add My Repairs filter to repair order search view -->
    <record id="view_repair_order_search_my_repairs" model="ir.ui.view">
        <field name="name">repair.order.search.my.repairs</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="My Repairs" name="my_repairs"
                        domain="[('user_id', '=', uid)]"/>
            </xpath>
        </field>
    </record>

    <!-- Set My Repairs as default filter on the repair order list action -->
    <function model="ir.actions.act_window" name="write">
        <value eval="[ref('repair.action_repair_order_tree')]"/>
        <value eval="{'context': {'search_default_my_repairs': 1}}"/>
    </function>

</odoo>
