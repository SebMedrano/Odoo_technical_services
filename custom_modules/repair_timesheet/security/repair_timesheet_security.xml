<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- ── REPAIR ORDER: TECHNICIAN READ ALL ────────────────────────────
             Technicians can read all repair orders.
             The list view defaults to "My Repairs" via a search filter
             so their view is focused on their own work by default.
        -->
        <record id="repair_order_rule_technician_read" model="ir.rule">
            <field name="name">repair.order.technician.read.all</field>
            <field name="model_id" search="[('model','=','repair.order')]" model="ir.model"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('techservices_groups.group_technician'))]"/>
        </record>

        <!-- ── REPAIR ORDER: TECHNICIAN WRITE OWN ───────────────────────────
             Technicians can only write repair orders assigned to them.
        -->
        <record id="repair_order_rule_technician_write" model="ir.rule">
            <field name="name">repair.order.technician.own.write</field>
            <field name="model_id" search="[('model','=','repair.order')]" model="ir.model"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('techservices_groups.group_technician'))]"/>
        </record>

        <!-- ── REPAIR ORDER: SUPERVISOR (all repairs) ───────────────────────
        -->
        <record id="repair_order_rule_supervisor" model="ir.rule">
            <field name="name">repair.order.supervisor.all</field>
            <field name="model_id" search="[('model','=','repair.order')]" model="ir.model"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('techservices_groups.group_supervisor'))]"/>
        </record>

        <!-- ── REPAIR ORDER: MANAGER (full access) ──────────────────────────
        -->
        <record id="repair_order_rule_manager" model="ir.rule">
            <field name="name">repair.order.manager.all</field>
            <field name="model_id" search="[('model','=','repair.order')]" model="ir.model"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('techservices_groups.group_manager'))]"/>
        </record>

        <!-- ── TIMESHEET LINES: TECHNICIAN ──────────────────────────────────
        -->
        <record id="repair_timesheet_line_rule_user" model="ir.rule">
            <field name="name">account.analytic.line.repair.technician</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="domain_force">[
                ('repair_id', '!=', False),
                ('user_id', '=', user.id),
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('techservices_groups.group_technician'))]"/>
        </record>

        <!-- ── TIMESHEET LINES: SUPERVISOR/MANAGER ──────────────────────────
        -->
        <record id="repair_timesheet_line_rule_supervisor" model="ir.rule">
            <field name="name">account.analytic.line.repair.supervisor</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="domain_force">[('repair_id', '!=', False)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('techservices_groups.group_supervisor'))]"/>
        </record>

    </data>
</odoo>
