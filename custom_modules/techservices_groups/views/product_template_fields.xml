<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!--
            Adds Supplier, Supplier Part Number, and Make fields to the product
            form for all user types.  Fields are placed in group_general on the
            General Information tab, directly after the Product Type radio buttons.
        -->
        <record id="product_template_form_add_supplier_fields" model="ir.ui.view">
            <field name="name">product.template.form.supplier.fields.techservices</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='group_general']/field[@name='type']" position="after">
                    <field name="x_description" placeholder="e.g. Oscilloscope, 100MHz bandwidth" rows="5"/>
                    <field name="x_make" placeholder="e.g. Agilent, Thermo Fisher"/>
                    <field name="x_make_part_number" placeholder="e.g. ABC-1234"/>
                    <field name="x_supplier_id" placeholder="e.g. VWR Scientific"/>
                    <field name="x_supplier_part_number" placeholder="e.g. 12345-678"/>
                    <field name="x_alt_supplier_id" placeholder="e.g. Fisher Scientific"/>
                    <field name="x_alt_supplier_part_number" placeholder="e.g. 98765-432"/>
                    <div class="text-muted small fst-italic" colspan="2">
                        Add any additional suppliers in the internal notes section
                    </div>
                    <field name="x_room_location" placeholder="e.g. Room 101"/>
                    <field name="x_drawer_location" placeholder="e.g. Drawer A3"/>
                </xpath>
            </field>
        </record>
        <!--
            Adds Make, Supplier, Supplier Part Number to the repair order
            product catalog search view (http://localhost:8069/odoo/repairs/.../product.product).
            The view is on product.product so fields are reached via product_tmpl_id.
        -->
        <record id="repair_catalog_search_techservices" model="ir.ui.view">
            <field name="name">repair.catalog.search.techservices</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="repair.product_view_search_catalog"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_tmpl_id']" position="after">
                    <field name="x_make" string="Make"/>
                    <field name="x_supplier_id" string="Supplier"/>
                    <field name="x_supplier_part_number" string="Supplier Part Number"/>
                </xpath>
            </field>
        </record>

        <!--
            Modifies the product list search view (action 479):
            - Removes Location and Warehouse pre-filter fields
            - Adds Make, Supplier, and Supplier Part Number as searchable fields
        -->
        <record id="product_template_search_techservices" model="ir.ui.view">
            <field name="name">product.template.search.techservices</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="stock.product_template_search_form_view_stock"/>
            <field name="arch" type="xml">
                <!-- Remove Location and Warehouse fields -->
                <xpath expr="//field[@name='location_id']" position="replace"/>
                <xpath expr="//field[@name='warehouse_id']" position="replace"/>
                <!-- Add custom search fields after the Tags field (always present, no groups restriction) -->
                <xpath expr="//field[@name='product_tag_ids']" position="after">
                    <field name="x_description" string="Product's description"/>
                    <field name="x_make" string="Make"/>
                    <field name="x_supplier_id" string="Supplier" filter_domain="[('x_supplier_id', 'child_of', self)]"/>
                    <field name="x_supplier_part_number" string="Supplier Part Number"/>
                </xpath>
            </field>
        </record>

        <!--
            Adds 'Date Added' (create_date) and "Product's description" (x_description)
            as optional columns in the product template list view (action-488).
        -->
        <record id="product_template_list_create_date" model="ir.ui.view">
            <field name="name">product.template.list.create_date.techservices</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="x_description" string="Product's description" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='uom_id']" position="after">
                    <field name="create_date" string="Date Added" optional="show" readonly="1"/>
                </xpath>
            </field>
        </record>

        <!--
            Adds "Product's description" (x_description) to the product kanban card,
            shown below the price line.
        -->
        <record id="product_template_kanban_x_description" model="ir.ui.view">
            <field name="name">product.template.kanban.x_description.techservices</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_kanban_view"/>
            <field name="arch" type="xml">
                <!-- Expose the field to the kanban renderer -->
                <xpath expr="//kanban/field[@name='categ_id']" position="after">
                    <field name="x_description"/>
                </xpath>
                <!-- Display below the price line -->
                <xpath expr="//span[field[@name='list_price']]" position="after">
                    <div t-if="record.x_description.value" class="text-muted small mt-1">
                        <field name="x_description"/>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
