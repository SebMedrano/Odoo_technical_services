<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hide Payment Terms and Other Info tab from Supervisor/Technician in sale order form -->

    <record id="view_sale_order_form_techservices" model="ir.ui.view">
        <field name="name">sale.order.form.techservices.groups</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="groups">techservices_groups.group_manager</attribute>
            </xpath>
            <xpath expr="//page[@name='other_information']" position="attributes">
                <attribute name="groups">techservices_groups.group_manager</attribute>
            </xpath>
            <!-- Ensure opportunity_id and opportunity_notes are always loaded so the
                 Opportunity Notes tab can evaluate its invisible condition even when
                 Other Info (which contains sale_crm's opportunity_id) is hidden. -->
            <xpath expr="//page[@name='order_lines']" position="before">
                <field name="opportunity_id" invisible="1"/>
                <field name="opportunity_notes" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Hide Optional Products tab from Supervisor/Technician -->

    <record id="sale_order_form_quote_techservices" model="ir.ui.view">
        <field name="name">sale.order.form.quote.techservices.groups</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='optional_products']" position="attributes">
                <attribute name="groups">techservices_groups.group_manager</attribute>
            </xpath>
        </field>
    </record>

</odoo>
